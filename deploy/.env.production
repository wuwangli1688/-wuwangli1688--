# ============================================
# 收支记账本 - 生产环境变量配置
# 部署路径：/path/to/app/server/.env
# 复制此文件后修改实际值
# ============================================

# Supabase 数据库连接（在你的 Supabase 项目后台获取）
COZE_SUPABASE_URL=https://your-project-id.supabase.co
COZE_SUPABASE_ANON_KEY=your-anon-key-here
COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 服务配置
PORT=9091
HOST=0.0.0.0
NODE_ENV=production

# 前端地址（用于 CORS 跨域配置）
FRONTEND_URL=https://your-domain.com